# Environment variables for Kimi Proxy
# Copy this file to kimi-proxy/.env and fill in your actual values

# Your Kimi API key from https://platform.moonshot.cn
KIMI_API_KEY=your-kimi-key-here

# Shared secret for authenticating Roblox requests
# This must match the SHARED_SECRET in src/server/KimiHandler.server.luau
SHARED_SECRET=super-secret-string-42

# Your DuckDNS domain (already configured for robleezy-ai.duckdns.org)
# The proxy will be accessible at: https://robleezy-ai.duckdns.org:8080
